<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>Resources\easyhfp.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\easyhfp.ico" LogicalName="EasyHFP.Resources.easyhfp.ico" />
    <EmbeddedResource Include="..\easyhfp_logo.png" Link="Resources\easyhfp_logo.png" LogicalName="EasyHFP.Resources.easyhfp_logo.png" />
  </ItemGroup>

</Project>
